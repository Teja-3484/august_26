import random

class Solution:
    def __init__(self, nums):
        self.original = nums[:]

    def reset(self):
        return self.original[:]

    def shuffle(self):
        arr = self.original[:]
        n = len(arr)
        for i in range(n):
            x = random.randint(0, n-1)
            for j in range(n):
                if i == j:
                    arr[x], arr[j] = arr[j], arr[x]
        return arr
