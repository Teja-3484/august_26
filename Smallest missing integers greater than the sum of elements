class Solution:
    def missingInteger(self, A: list[int]) -> int:
        n = len(A)
        s= set(A)
        Sum= A[0]

        for i in range(1, n):
            if A[i] == A[i - 1] + 1:
                Sum += A[i]
            else:
                break

        while Sum in s:
            Sum += 1

        return Sum
